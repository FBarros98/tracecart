# TraceCart - local environment configuration.
# Copy to .env (cp .env.example .env) and adjust. All values below are local placeholders,
# never real credentials. .env is git-ignored.

# --- Environment / logging --------------------------------------------------------------
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- PostgreSQL (single instance, two databases) ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Dedicated role for tracecart_orders (used only by the Order Service)
ORDER_DB_USER=tracecart_order
ORDER_DB_PASSWORD=change-me-orders
# Dedicated role for tracecart_payments (used only by the Payment Service)
PAYMENT_DB_USER=tracecart_payment
PAYMENT_DB_PASSWORD=change-me-payments

# --- Ports published on the host (containers always listen on 8000) ---------------------
ORDER_SERVICE_PORT=8000
PAYMENT_SERVICE_PORT=8001

# --- Service-to-service communication ---------------------------------------------------
# Docker Compose DNS name of the Payment Service (internal port 8000)
PAYMENT_SERVICE_URL=http://tracecart-payment-service:8000
# HTTP timeout used by the Order Service when calling the Payment Service
PAYMENT_SERVICE_TIMEOUT_SECONDS=5

# --- OpenTelemetry (zero-code instrumentation, both services) ----------------------------
# true turns the SDK off entirely (no spans, no exporter connections)
OTEL_SDK_DISABLED=false
# otlp (sent to the collector) | console (spans printed to the container logs) | none
OTEL_TRACES_EXPORTER=otlp
# otlp | console | none
OTEL_METRICS_EXPORTER=otlp
# otlp | console | none (logs are always written to stdout as well)
OTEL_LOGS_EXPORTER=otlp
# OTLP receiver (the tracecart-otel-collector service)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tracecart-otel-collector:4318
# grpc | http/protobuf (use port 4318 for http/protobuf)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Version reported as service.version (Datadog "version" tag) on every signal of each service.
# Keep in sync with the FastAPI version in services/*/app/main.py.
ORDER_SERVICE_VERSION=1.0.0
PAYMENT_SERVICE_VERSION=1.0.0

# --- Cribl self-hosted (destination of all telemetry: traces, metrics and logs) ----------
# Image tag of the tracecart-cribl container (Cribl Stream; pinned, do not use latest).
CRIBL_VERSION=4.20.4
# Host port of the Cribl UI.
CRIBL_UI_PORT=9000
# host:port of the OpenTelemetry Source (OTLP/gRPC, no TLS) of the tracecart-cribl container,
# reached through the Compose network. The Source needs OTLP version 1.3.1 (0.10.0 does not
# accept logs).
CRIBL_OTLP_ENDPOINT=tracecart-cribl:4317
# Optional: token configured in the Source's Authentication (sent as "authorization: Bearer
# <token>"). Leave empty if the Source has no authentication. Keep any real token only in .env.
CRIBL_AUTH_TOKEN=

# --- Fault injection (Payment Service). All disabled by default; rates between 0 and 1 ----
# Declines a share of the transactions
PAYMENT_DECLINE_ENABLED=false
PAYMENT_DECLINE_RATE=0.0
# Artificial latency (asyncio.sleep) before finishing a payment, uniform between MIN and MAX.
# Use values above PAYMENT_SERVICE_TIMEOUT_SECONDS (e.g. 6000-8000) to provoke timeouts.
PAYMENT_LATENCY_ENABLED=false
PAYMENT_LATENCY_MIN_MS=0
PAYMENT_LATENCY_MAX_MS=0
# Intermittent database failures (HTTP 503, transaction rolled back, no data lost)
DATABASE_FAILURE_ENABLED=false
DATABASE_FAILURE_RATE=0.0
# Unexpected internal errors (HTTP 500 with a generic body)
UNEXPECTED_ERROR_ENABLED=false
UNEXPECTED_ERROR_RATE=0.0
